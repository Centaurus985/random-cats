{
    "family": "random-cats-web",
    "executionRoleArn": "arn:aws:iam::358140414416:role/random-cats-ecs-task-execution",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "volumes": [],
    "placementConstraints": [],
    "containerDefinitions": [
        {
            "name": "web",
            "image": "358140414416.dkr.ecr.ap-southeast-2.amazonaws.com/random-cats-web:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/random-cats-web",
                    "awslogs-region": "ap-southeast-2",
                    "awslogs-stream-prefix": "web"
                }
            },
            "systemControls": []
        }
    ]
}
